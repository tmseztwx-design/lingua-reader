-- Scribe 云端书库：表结构、独立存储桶、行级安全。按仓库 supabase/migrations 顺序执行。
create extension if not exists pg_cron with schema pg_catalog;
create extension if not exists pg_net with schema extensions;

create table if not exists public.scribe_cloud_sessions (
  id uuid primary key default gen_random_uuid(),
  token text not null unique,
  title text,
  file_count integer not null default 0,
  ocr_status text not null default 'pending',
  ocr_completed_at timestamptz,
  completed_at timestamptz,
  created_at timestamptz not null default now(),
  expires_at timestamptz not null
);

create table if not exists public.scribe_cloud_files (
  id uuid primary key default gen_random_uuid(),
  session_id uuid not null references public.scribe_cloud_sessions(id) on delete cascade,
  queue_order integer not null default 0,
  name text not null,
  size bigint not null default 0,
  mime text,
  storage_path text,
  uploaded_at timestamptz,
  ocr_status text not null default 'pending',
  ocr_text text,
  ocr_error text,
  page_count integer,
  ocr_completed_at timestamptz,
  created_at timestamptz not null default now()
);

create index if not exists scribe_cloud_sessions_token_idx on public.scribe_cloud_sessions (token);
create index if not exists scribe_cloud_files_session_order_idx on public.scribe_cloud_files (session_id, queue_order);

alter table public.scribe_cloud_sessions enable row level security;
alter table public.scribe_cloud_files enable row level security;

insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('scribe-pages','scribe-pages', false, 104857600, array['application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','image/jpeg','image/png','image/heic','image/heif','text/plain']::text[])
on conflict (id) do nothing;

-- 私密跨设备书库与后台队列
create table if not exists public.scribe_libraries (
  id uuid primary key default gen_random_uuid(),
  access_hash text not null unique,
  created_at timestamptz not null default now()
);
create table if not exists public.scribe_library_entries (
  library_id uuid not null references public.scribe_libraries(id) on delete cascade,
  kind text not null check (kind in ('doc','card','preferences')),
  entry_id text not null,
  value jsonb,
  deleted boolean not null default false,
  revision bigint not null default 1,
  updated_at timestamptz not null default now(),
  primary key (library_id, kind, entry_id)
);
create table if not exists public.scribe_runtime_settings (
  id boolean primary key default true check (id),
  worker_secret text not null default replace(gen_random_uuid()::text||gen_random_uuid()::text,'-','')
);
insert into public.scribe_runtime_settings(id) values(true) on conflict do nothing;
alter table public.scribe_libraries enable row level security;
alter table public.scribe_library_entries enable row level security;
alter table public.scribe_runtime_settings enable row level security;
revoke all on public.scribe_libraries,public.scribe_library_entries,public.scribe_runtime_settings from anon,authenticated;
grant all on public.scribe_libraries,public.scribe_library_entries,public.scribe_runtime_settings to service_role;

alter table public.scribe_cloud_sessions add column library_id uuid references public.scribe_libraries(id);
alter table public.scribe_cloud_sessions add column deleted_at timestamptz;
alter table public.scribe_cloud_files add column attempts integer not null default 0;
alter table public.scribe_cloud_files add column lease_id uuid;
alter table public.scribe_cloud_files add column lease_until timestamptz;
alter table public.scribe_cloud_files add column retry_at timestamptz;
create index if not exists scribe_library_sessions_idx on public.scribe_cloud_sessions(library_id);

-- 逐段译文
 alter table public.scribe_cloud_files add column paragraphs jsonb;

-- 点词卡片词典：同一个词在同一句语境中的音标与释义只消耗一次额度，并在多设备间复用。
create table if not exists public.scribe_word_cache (
  cache_key text primary key,
  phonetic text not null default '',
  meaning text not null default '',
  gloss text not null default '',
  updated_at timestamptz not null default now()
);
alter table public.scribe_word_cache enable row level security;
revoke all on public.scribe_word_cache from anon,authenticated;
grant all on public.scribe_word_cache to service_role;

-- 内测码：一个码对应一份长期保留的书库数据；后台只保存哈希与尾号，明文只在生成时返回一次。
create table if not exists public.scribe_beta_codes (
  id uuid primary key default gen_random_uuid(),
  code_hash text not null unique,
  code_mask text not null default '',
  label text not null default '',
  library_id uuid references public.scribe_libraries(id) on delete set null,
  revoked boolean not null default false,
  created_at timestamptz not null default now(),
  redeemed_at timestamptz,
  last_seen_at timestamptz
);
create table if not exists public.scribe_library_access (
  library_id uuid not null references public.scribe_libraries(id) on delete cascade,
  access_hash text not null unique,
  label text not null default '',
  created_at timestamptz not null default now()
);
create index if not exists scribe_library_access_library_idx on public.scribe_library_access(library_id);
create table if not exists public.scribe_beta_guard (
  id boolean primary key default true check (id),
  failed_attempts integer not null default 0,
  locked_until timestamptz
);
insert into public.scribe_beta_guard(id) values(true) on conflict do nothing;

alter table public.scribe_beta_codes enable row level security;
alter table public.scribe_library_access enable row level security;
alter table public.scribe_beta_guard enable row level security;
revoke all on public.scribe_beta_codes,public.scribe_library_access,public.scribe_beta_guard from anon,authenticated;
grant all on public.scribe_beta_codes,public.scribe_library_access,public.scribe_beta_guard to service_role;