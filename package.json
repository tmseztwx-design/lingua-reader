{
  "name": "scribe-lingua-reader",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "check": "node --check server.mjs && python3 -c \"import ast, pathlib; ast.parse(pathlib.Path('ocr_worker.py').read_text(encoding='utf-8'))\"",
    "test": "node --test test/*.test.mjs && node test/server-smoke.mjs",
    "bundle:functions": "node scripts/bundle-functions.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^29.1.1",
    "vite": "^7.1.4",
    "vite-plugin-enter-dev": "^0.0.16"
  }
}
